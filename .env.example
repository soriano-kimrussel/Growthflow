# Copy to .env and adjust. Never commit .env.

# Local development (SQLite file, relative to the project root).
DATABASE_URL="file:./prisma/dev.db"
# Production: a hosted Postgres (Neon / Supabase). The provider switches automatically.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Provider adapters. Only "simulated" ships; add a real provider in lib/providers/*.
MESSAGING_PROVIDER="simulated"
PAYMENTS_PROVIDER="simulated"

# Shared secret for the scheduled runner endpoint (/api/runner).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="change-me"

# Public base URL, used in invitation links. Optional locally.
# APP_URL="https://your-app.vercel.app"
