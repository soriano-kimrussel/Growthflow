# Copy to .env and adjust. Never commit .env.

# Local development (SQLite file, relative to the project root).
DATABASE_URL="file:./prisma/dev.db"
# Production: a hosted Postgres. The provider switches automatically.
# Supabase (see README): the app uses the transaction pooler, the Prisma CLI the session pooler.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require"
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Provider adapters. Only "simulated" ships; add a real provider in lib/providers/*.
MESSAGING_PROVIDER="simulated"
PAYMENTS_PROVIDER="simulated"

# Shared secret for the scheduled runner endpoint (/api/runner).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="change-me"

# Public base URL, used in invitation links. Optional locally.
# APP_URL="https://your-app.vercel.app"
# zUpVYOFRxUQMze1H
